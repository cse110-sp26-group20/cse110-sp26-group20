{
  "name": "backend",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "dev": "tsx watch --include 'src/**/*.ts' src/server.ts",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@types/multer": "^2.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.8.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsc-alias": "1.8.17",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
